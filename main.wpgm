import wollok.game.*
import personajes.*
import interacciones.*

program Pixeldungeon {
	game.title("Pixeldungeon")
	game.height(10)
	game.width(15)
	game.cellSize(128)
	game.boardGround("background.png")

	const finn = new Personaje(nombre = "finn", position = game.at(3,3))
	const esqueleto = new Personaje(nombre = "esqueleto", position = game.at(5,5))

	game.addVisual(finn)
	game.addVisual(esqueleto)

	controles.movimientosDelJugador(finn)

	game.start()
}
