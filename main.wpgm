import wollok.game.*
import personajes.*
import interacciones.*

program Pixeldungeon {
	game.title("Pixeldungeon")
	game.height(10)
	game.width(15)
	game.cellSize(128)
	
	const finn = new Personaje(
		nombre = "finn",
		salud = 100,
		damage = 20,
		position = game.at(3,3))
	
	const esqueleto_1 = new Personaje(
		nombre = "esqueleto",
		salud = 50,
		damage = 10,
		position = game.at(5,5))
	
	const esqueleto_2 = new Personaje(
		nombre = "esqueleto",
		salud = 50,
		damage = 10,
		position = game.at(2,1))
	
	const esqueleto_3 = new Personaje(
		nombre = "esqueleto",
		salud = 50,
		damage = 10,
		position = game.at(7,7))
	

	controles.movimientosDelJugador(finn)
	controles.ataquesDelJugadorA(finn,esqueleto_1)
	controles.ataquesDelJugadorA(finn,esqueleto_2)
	controles.ataquesDelJugadorA(finn,esqueleto_3)

	game.boardGround("bg_lvl1.png")

	game.addVisual(finn)
	game.addVisual(esqueleto_1)
	game.addVisual(esqueleto_2)
	game.addVisual(esqueleto_3)

	game.start()
}
