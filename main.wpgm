import wollok.game.*
import personajes.*
import controles.*

program Pixeldungeon {
	game.title("Pixeldungeon")
	game.height(10)
	game.width(15)
	game.cellSize(128)
	game.boardGround("background.png")

	const finn = new Personaje(nombre = "finn", position = game.at(3,3))

	game.addVisual(finn)

	keyboard.w().onPressDo({finn.moverseAl("up")})
	keyboard.a().onPressDo({finn.moverseAl("left")})
	keyboard.s().onPressDo({finn.moverseAl("down")})
	keyboard.d().onPressDo({finn.moverseAl("right")})

	game.start()
}
