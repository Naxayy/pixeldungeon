import wollok.game.*
import personajes.*
import interacciones.*

program Pixeldungeon {
	game.title("Pixeldungeon")
	game.height(10)
	game.width(15)
	game.cellSize(128)
	
	const finn = new Personaje(
		nombre = "finn",
		salud = 100,
		damage = 20,
		position = game.at(3,3))
	
	const esqueleto = new Personaje(
		nombre = "esqueleto",
		salud = 50,
		damage = 10,
		position = game.at(5,5))

	controles.movimientosDelJugador(finn)
	controles.ataquesDelJugador(finn)
	
	game.boardGround("bg_lvl1.png")

	game.addVisual(finn)
	game.addVisual(esqueleto)

	game.start()
}
